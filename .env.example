# Application
APP_ENV=development
APP_NAME=Financial Advisor API
LOG_LEVEL=INFO

# IBM Cloudant (IAM authentication)
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DATABASE=finance-advisor-db
# Set only when running protected Cloudant diagnostic endpoints.
CLOUDANT_DIAGNOSTICS_TOKEN=

# Authentication
# Generate independent random values of at least 32 bytes for both secrets.
JWT_SECRET_KEY=
AUTH_EMAIL_INDEX_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Leave empty to keep account registration disabled.
REGISTRATION_INVITE_CODE=
# Shared Redis rate limiting. Keep disabled until a Redis service is provisioned.
AUTH_RATE_LIMIT_ENABLED=false
REDIS_URL=

# Transactional email, see docs/transactional-email.md.
# Keep disabled until IBM Event Notifications, verified sender domain,
# SMTP authorization, CBR and real delivery checks are complete.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Financial Advisor
APP_PUBLIC_URL=

# Persistent financial data is disabled until backups, retention, deletion,
# audit logging and the privacy/security release checklist are complete.
FINANCIAL_DATA_ENABLED=false
FINANCIAL_AI_ENABLED=false

# IBM watsonx.ai (planned)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_MODEL_ID=
WATSONX_API_VERSION=

# IBM Cloud Object Storage (planned)
COS_ENDPOINT=
COS_BUCKET=
COS_INSTANCE_ID=
COS_API_KEY=

# CORS (planned; set explicit frontend origins before enabling browser clients)
CORS_ORIGINS=
